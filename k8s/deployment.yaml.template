apiVersion: apps/v1
kind: Deployment
metadata:
  name: workshop-signup-bot
  namespace: matvey-gang
  labels:
    app: workshop-signup-bot
spec:
  replicas: 1
  selector:
    matchLabels:
      app: workshop-signup-bot
  template:
    metadata:
      labels:
        app: workshop-signup-bot
    spec:
      containers:
        - name: bot
          image: ghcr.io/YOUR_ORG/workshop-signup-bot:v1.0
          imagePullPolicy: IfNotPresent
          env:
            - name: BOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: BOT_TOKEN
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: DATABASE_URL
            - name: CONFIG_PATH
              value: "/app/config/config.toml"
          volumeMounts:
            - name: config
              mountPath: /app/config
              readOnly: true
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
            limits:
              memory: "128Mi"
              cpu: "200m"
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
      volumes:
        - name: config
          configMap:
            name: workshop-bot-config
      restartPolicy: Always
