apiVersion: apps/v1
kind: Deployment
metadata:
  name: workshop-signup-bot
  namespace: matvey-gang
  labels:
    app: workshop-signup-bot
spec:
  replicas: 1
  selector:
    matchLabels:
      app: workshop-signup-bot
  template:
    metadata:
      labels:
        app: workshop-signup-bot
    spec:
      containers:
        - name: bot
          image: ghcr.io/YOUR_ORG/workshop-signup-bot:v1.0
          imagePullPolicy: IfNotPresent
          env:
            - name: BOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: BOT_TOKEN
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: DATABASE_URL
            - name: CONFIG_PATH
              value: "/app/config/config.toml"
            # R2 configuration (optional - visualization falls back to local storage)
            - name: R2_ENDPOINT_URL
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_ENDPOINT_URL
                  optional: true
            - name: R2_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_ACCESS_KEY_ID
                  optional: true
            - name: R2_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_SECRET_ACCESS_KEY
                  optional: true
            - name: R2_BUCKET_NAME
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_BUCKET_NAME
                  optional: true
            - name: R2_PUBLIC_URL
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_PUBLIC_URL
                  optional: true
            - name: R2_UPLOAD_PREFIX
              valueFrom:
                secretKeyRef:
                  name: workshop-bot-secrets
                  key: R2_UPLOAD_PREFIX
                  optional: true
          volumeMounts:
            - name: config
              mountPath: /app/config
              readOnly: true
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
            limits:
              memory: "128Mi"
              cpu: "200m"
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
      volumes:
        - name: config
          configMap:
            name: workshop-bot-config
      restartPolicy: Always
