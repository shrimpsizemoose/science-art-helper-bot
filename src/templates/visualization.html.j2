<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ event.title }} - Event Visualization</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation"></script>
    <style>
        :root {
            --bg-primary: #1a1a2e;
            --bg-secondary: #16213e;
            --bg-card: #0f3460;
            --text-primary: #eee;
            --text-secondary: #aaa;
            --accent: #e94560;
            --accent-secondary: #0096c7;
            --success: #2ecc71;
            --warning: #f1c40f;
            --danger: #e74c3c;
            --border-radius: 12px;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            --chart-text: #eee;
            --chart-grid: rgba(255,255,255,0.1);
        }

        [data-theme="light"] {
            --bg-primary: #f5f5f5;
            --bg-secondary: #e8e8e8;
            --bg-card: #ffffff;
            --text-primary: #222;
            --text-secondary: #666;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --chart-text: #222;
            --chart-grid: rgba(0,0,0,0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 20px;
            min-height: 100vh;
            transition: background 0.3s, color 0.3s;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            background: var(--bg-card);
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.2rem;
            box-shadow: var(--shadow);
            z-index: 100;
            transition: background 0.3s;
        }

        .theme-toggle:hover {
            opacity: 0.8;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            padding: 30px;
            background: linear-gradient(135deg, var(--bg-secondary), var(--bg-card));
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            color: var(--accent);
        }

        .header .event-code {
            font-family: monospace;
            background: var(--bg-primary);
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 10px;
        }

        .header .datetime {
            color: var(--text-secondary);
            margin-top: 15px;
            font-size: 1.1rem;
        }

        .description {
            margin-top: 20px;
            padding: 15px;
            background: var(--bg-primary);
            border-radius: 8px;
            color: var(--text-secondary);
            text-align: left;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .card {
            background: var(--bg-card);
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 1.3rem;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent);
            color: var(--text-primary);
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .stat-item {
            background: var(--bg-secondary);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--accent);
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .stat-item.success .stat-value { color: var(--success); }
        .stat-item.warning .stat-value { color: var(--warning); }
        .stat-item.danger .stat-value { color: var(--danger); }

        .chart-container {
            position: relative;
            height: 300px;
            margin-top: 10px;
        }

        .chart-legend {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin-top: 15px;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .chart-legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chart-legend-color {
            width: 12px;
            height: 12px;
            border-radius: 2px;
        }

        .broadcast-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .broadcast-item {
            background: var(--bg-secondary);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .broadcast-item:last-child {
            margin-bottom: 0;
        }

        .broadcast-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .broadcast-date {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .broadcast-stats {
            display: flex;
            gap: 15px;
            font-size: 0.9rem;
        }

        .broadcast-stats .sent { color: var(--success); }
        .broadcast-stats .failed { color: var(--danger); }

        .broadcast-message {
            padding: 10px;
            background: var(--bg-primary);
            border-radius: 6px;
            font-size: 0.95rem;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .broadcast-footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-top: 8px;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .failure-details {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .failure-tag {
            background: var(--bg-primary);
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            color: var(--danger);
        }

        .generated-at {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid var(--bg-card);
        }

        .no-data {
            color: var(--text-secondary);
            text-align: center;
            padding: 40px;
        }

        @media (max-width: 768px) {
            .header h1 { font-size: 1.8rem; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .broadcast-footer { flex-direction: column; gap: 8px; }
        }

        @media (max-width: 480px) {
            .stats-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">🌓</button>

    <div class="container">
        <header class="header">
            <h1>{{ event.title }}</h1>
            <span class="event-code">Code: {{ event.code }}</span>
            <div class="datetime">{{ event.datetime_text or 'No date set' }}</div>
            {% if event.description %}
            <div class="description">{{ event.description }}</div>
            {% endif %}
        </header>

        <div class="card">
            <h2 class="card-title">Registration Statistics</h2>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value">{{ stats.total_registrations }}</div>
                    <div class="stat-label">Total</div>
                </div>
                <div class="stat-item success">
                    <div class="stat-value">{{ stats.confirmed_count }}</div>
                    <div class="stat-label">Confirmed</div>
                </div>
                <div class="stat-item warning">
                    <div class="stat-value">{{ stats.pending_count }}</div>
                    <div class="stat-label">Pending</div>
                </div>
                <div class="stat-item danger">
                    <div class="stat-value">{{ stats.cancelled_count }}</div>
                    <div class="stat-label">Cancelled</div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Registration Timeline</h2>
            <div class="chart-container">
                <canvas id="registrationChart"></canvas>
            </div>
            {% if broadcast_dates %}
            <div class="chart-legend">
                <div class="chart-legend-item">
                    <div class="chart-legend-color" style="background: #e94560;"></div>
                    <span>Registrations</span>
                </div>
                <div class="chart-legend-item">
                    <div class="chart-legend-color" style="background: #0096c7;"></div>
                    <span>Broadcasts</span>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="card">
            <h2 class="card-title">Broadcast Statistics</h2>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value">{{ stats.total_broadcasts }}</div>
                    <div class="stat-label">Total</div>
                </div>
                <div class="stat-item success">
                    <div class="stat-value">{{ stats.total_messages_sent }}</div>
                    <div class="stat-label">Sent</div>
                </div>
                <div class="stat-item danger">
                    <div class="stat-value">{{ stats.total_messages_failed }}</div>
                    <div class="stat-label">Failed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">{{ stats.delivery_rate }}%</div>
                    <div class="stat-label">Delivery Rate</div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2 class="card-title">Broadcast History</h2>
            {% if broadcasts_with_failures %}
            <div class="broadcast-list">
                {% for item in broadcasts_with_failures %}
                {% set broadcast = item.broadcast %}
                {% set failures = item.failure_details %}
                <div class="broadcast-item">
                    <div class="broadcast-header">
                        <span class="broadcast-date">{{ broadcast.sent_at.strftime('%Y-%m-%d %H:%M') if broadcast.sent_at.strftime is defined else broadcast.sent_at[:16].replace('T', ' ') }}</span>
                        <div class="broadcast-stats">
                            <span class="sent">{{ broadcast.sent_count }} sent</span>
                            <span class="failed">{{ broadcast.failed_count }} failed</span>
                        </div>
                    </div>
                    <div class="broadcast-message">{{ broadcast.message_text[:500] }}{% if broadcast.message_text|length > 500 %}...{% endif %}</div>
                    <div class="broadcast-footer">
                        <span>Target: {{ broadcast.target_audience or 'all' }}</span>
                        {% if failures %}
                        <div class="failure-details">
                            {% for reason, count in failures.items() %}
                            <span class="failure-tag">{{ reason }}: {{ count }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="no-data">No broadcasts sent for this event</div>
            {% endif %}
        </div>

        <div class="generated-at">
            Generated on {{ generated_at }}
        </div>
    </div>

    <script>
        function toggleTheme() {
            const html = document.documentElement;
            const current = html.getAttribute('data-theme');
            const next = current === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateChart();
        }

        function getChartColors() {
            const style = getComputedStyle(document.documentElement);
            return {
                text: style.getPropertyValue('--chart-text').trim(),
                grid: style.getPropertyValue('--chart-grid').trim()
            };
        }

        // Load saved theme
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            document.documentElement.setAttribute('data-theme', savedTheme);
        }

        const registrationData = {{ registration_timeline | tojson }};
        const broadcastDates = {{ broadcast_dates | tojson }};
        let chart = null;

        function buildAnnotations() {
            const annotations = {};
            const uniqueDates = [...new Set(broadcastDates)];

            uniqueDates.forEach((date, i) => {
                if (registrationData.labels.includes(date)) {
                    annotations[`broadcast${i}`] = {
                        type: 'line',
                        xMin: date,
                        xMax: date,
                        borderColor: '#0096c7',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        label: {
                            display: true,
                            content: '📢',
                            position: 'start',
                            font: { size: 14 }
                        }
                    };
                }
            });
            return annotations;
        }

        function updateChart() {
            const colors = getChartColors();
            if (chart) {
                chart.options.plugins.legend.labels.color = colors.text;
                chart.options.scales.x.ticks.color = colors.text;
                chart.options.scales.x.grid.color = colors.grid;
                chart.options.scales.y.ticks.color = colors.text;
                chart.options.scales.y.grid.color = colors.grid;
                chart.update();
            }
        }

        if (registrationData.labels.length > 0) {
            const ctx = document.getElementById('registrationChart').getContext('2d');
            const colors = getChartColors();
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: registrationData.labels,
                    datasets: [{
                        label: 'Cumulative Registrations',
                        data: registrationData.cumulative,
                        borderColor: '#e94560',
                        backgroundColor: 'rgba(233, 69, 96, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        annotation: {
                            annotations: buildAnnotations()
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: colors.text },
                            grid: { color: colors.grid }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: { color: colors.text },
                            grid: { color: colors.grid }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
